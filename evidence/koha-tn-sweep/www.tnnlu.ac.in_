			"/js/nprogress.js?v=ats-cms.1.0",
			"/js/sweetalert.min.js?v=ats-cms.1.0",
			"/js/sweetalert.min.js?v=ats-cms.1.0",
			"/js/jquery.easing.js?v=ats-cms.1.0",
			"/js/jquery.mousewheel.js?v=ats-cms.1.0",
			"/js/imgal.js?v=ats-cms.1.0",
			"/js/css-vars-ponyfill.js",
			"/js/beautify-css.min.js",
			"/js/script.js",
			"//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit");

head.ready(function () {
			var bar=$('#progress_bar');
$(document).ready(function(){
var percentage=parseInt($('#progress_percentage').html());
var resize=sessionStorage.getItem("resize");
if(resize!=null)
	$("body").attr("style",resize);
 $("#font-sizeUp").click(function() {
	$("body").attr("style","font-size:130% !important");
	sessionStorage.setItem("resize","font-size:130% !important");
});

$("#font-sizenormal").click(function() {
	$("body").attr("style","font-size:100% !important");
	sessionStorage.setItem("resize","font-size:100% !important");
})

$("#font-sizeDown").click(function() {
	$("body").attr("style","font-size:70% !important");
	sessionStorage.setItem("resize","font-size:70% !important");
})

function stopProgress(){
  clearInterval(progress);
}

var progress= setInterval(function(){
  percentage++;
  if (percentage<=100){
    $('#progress_percentage').html(percentage+'%');
    if (percentage>10) {
      bar.css('width',percentage+'%');
    }
  }
  else {
    stopProgress()
  }
},80);
});
});
</script>

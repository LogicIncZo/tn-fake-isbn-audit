<script>
head.load('/css/jquery.background-video.css','/css/owl.carousel.css','/js/owl.carousel.min.js','/js/jquery.autoscroll.js','/js/wow.min.js','/js/jquery.counterup.min.js','/js/waypoints.min.js','js/jquery.background-video.js');
head.ready(function () {
$(document).ready(function(){
	var wow=new WOW({mobile:false});wow.init();
	$('.jquery-background-video').bgVideo({fullScreen:!1,fadeIn:500,pauseAfter:0,fadeOnPause:!1,fadeOnEnd:!1,showPausePlay:!1,pausePlayXPos:'right',pausePlayYPos:'top',pausePlayXOffset:'100px',pausePlayYOffset:'100px'});
	$( '.home-slider' ).owlCarousel( {
		items: 1,
		nav: true,
		dots: true,
		loop: true,
		autoplay: true,
		autoplayTimeout: 7500,
		autoplaySpeed: 3000,
		navSpeed: 1000,
		dotsSpeed: 1000,
		navText: [ '<i class="fa fa-angle-left"></i>','<i class="fa fa-angle-right"></i>' ]
	} );
	$( '#announcement-list' ).owlCarousel( {
		items: 1,
		nav: true,
		dots: false,
		loop: true,
		autoplay: true,
		responsive : {
            480 : { items : 1  },
            768 : { items : 2  },
            1024 : { items : 3 }
        },
		autoplayTimeout: 7500,
		autoplaySpeed: 3000,
		navSpeed: 1000,
		dotsSpeed: 1000,
		navText: [ '<i class="fa fa-angle-left"></i>','<i class="fa fa-angle-right"></i>' ]
	} );
	$( '#center-data' ).owlCarousel( {
		nav: false,
		dots: true,
		loop: true,
		autoplay: true,
		items : 1,
		responsive : {
            480 : { items : 1  },
            768 : { items : 2  },
            1024 : { items : 2 },
            1199 : { items : 3 },
        },
		autoplayTimeout: 7500,
		autoplaySpeed: 3000,
		navSpeed: 1000,
		dotsSpeed: 1000,
		dotsContainer: '.center-data-dots',
	} );
	$(".center-data-next").click(function(){
		$('#center-data').trigger('next.owl.carousel');
	});
	$(".center-data-prev").click(function(){
		$('#center-data').trigger('prev.owl.carousel');
	});
	var aboutContainer = $('.about-counter');
    if (aboutContainer.length) {
        aboutContainer.counterUp({
            delay: 50,
            time: 5000
        });

    }
});
});
</script></main>

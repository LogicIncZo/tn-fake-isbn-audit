<!-- Admission 2026 Floating Popup Widget -->
<div id="admission-popup" class="admission-popup-widget collapsed">
	<div class="admission-popup-header" onclick="toggleAdmissionPopup()">
		<span class="admission-popup-dot"></span>
		<strong>Admission 2026</strong>
		<span class="admission-popup-close" id="admission-popup-toggle">+</span>
	</div>
	<div class="admission-popup-body" id="admission-popup-body">
		<div class="admission-popup-item">
			<a href="/TNNLU-AVS-2026-27" class="admission-popup-link">
				<span class="admission-popup-icon">&#9654;</span> UG & PG Programme
			</a>
		</div>
		<div class="admission-popup-item">
			<a href="https://drive.google.com/file/d/1zYosK7KxMteuoTm-uAaQUpL0P3ZKesPZ/view" class="admission-popup-link">
				<span class="admission-popup-icon">&#9654;</span> PGDFLP
			</a>
		</div>
	</div>
</div>

<style>
.admission-popup-widget {
	position: fixed;
	bottom: 110px;
	right: 0;
	width: 220px;
	background-color:var(--primary-color);
	color: #fff;
	border-radius: 8px 0 0 8px;
	box-shadow: -3px 3px 12px rgba(0,0,0,0.35);
	z-index: 9999;
	font-family: inherit;
	overflow: hidden;
	transition: width 0.3s ease;
}
.admission-popup-header {
	background-color: var(--primary-color);
	padding: 10px 14px;
	cursor: pointer;
	display: flex;
	align-items: center;
	gap: 8px;
	user-select: none;
	border-bottom: 1px solid rgba(255,255,255,0.15);
}
.admission-popup-header strong {
	flex: 1;
	font-size: 14px;
	color: var(--white-color);
}
.admission-popup-dot {
	display: inline-block;
	width: 12px;
	height: 12px;
	background-color: var(--highlight-color);
	border-radius: 2px;
	flex-shrink: 0;
}
.admission-popup-close {
	font-size: 18px;
	font-weight: bold;
	color: #fff;
	line-height: 1;
	flex-shrink: 0;
}
.admission-popup-body {
	padding: 6px 0;
}
.admission-popup-item {
	border-bottom: 1px solid rgba(255,255,255,0.1);
}
.admission-popup-item:last-child {
	border-bottom: none;
}
.admission-popup-link {
	display: flex;
	align-items: center;
	gap: 8px;
	padding: 10px 14px;
	color: #fff;
	text-decoration: none;
	font-size: 13px;
	transition: background 0.2s;
}
.admission-popup-link:hover {
	background-color: rgba(255,255,255,0.12);
	color: var(--highlight-color);
	text-decoration: none;
}
.admission-popup-icon {
	font-size: 10px;
	color: var(--highlight-color);
}
.admission-popup-widget.collapsed .admission-popup-body {
	display: none;
}
.admission-popup-widget.collapsed .admission-popup-close {
	content: '+';
}
</style>

<script>
function toggleAdmissionPopup() {
	var widget = document.getElementById('admission-popup');
	var toggle = document.getElementById('admission-popup-toggle');
	if (widget.classList.contains('collapsed')) {
		widget.classList.remove('collapsed');
		toggle.innerHTML = '&#8211;';
	} else {
		widget.classList.add('collapsed');
		toggle.innerHTML = '+';
	}
}
</script>

</body>
</html>
}
.section-title{
	font-family: var(--secondary-font);
	color:var(--primary-color);
	font-size:var(--font-12x);
	margin-bottom:20px;
	position:relative;
	text-align:center;
}
.section{
    padding: 88px 0 70px;
}
.news-card {
    background: var(--white-color);
	height: 100%;
    padding-bottom: 20px;
}
.news_image {
}
.news_image {
    height: 200px;
	width:100%;
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
    -webkit-transition: all 0.3s ease-in-out;
    position: relative;
}
.news-details {
    padding: 15px;
	position:relative;
}
.news-title{
    font-size: var(--font-5x);
    color: var(--primary-color);
	font-family:var(--secondary-font);
	display: block;
    display: -webkit-box;
    max-width: calc(100% - 5px);
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
}
.news-desc{
    font-size: var(--font-3x);
	display: block;
    display: -webkit-box;
    max-width: calc(100% - 5px);
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
	white-space:pre-wrap;
}
.news-date {
    color: var(--secondary-color);
    font-style: italic;
	position:absolute;
    bottom: -5px;
    padding-left: 10px;
	line-height:40px;
}
.counter-area {
    padding: 130px 0 135px;
    text-align: center;
    position: relative;
    background-position: center;
    background-size: cover;
    background-repeat: no-repeat;
}
.counter-area:before {
    content: "";
    height: 100%;
    width: 100%;
    top: 0;
    left: 0;
    right: 0;
    margin: 0 auto;
    position: absolute;
    background-color: var(--primary-color)e6;
}
.counter-area .counter-box {
    display: -webkit-box;
    display: -webkit-flex;
    display: -moz-flex;
    display: -ms-flex;
    display: -o-flex;
    display: flex;
}
.counter-area .counter-box h2 {
	font-family:var(--secondary-font);
    color: var(--white-color);
    font-size: 72px !important;
    -webkit-box-flex: 1;
    -moz-flex: 1;
    -webkit-flex: 1;
    flex: 1;
    line-height: 1.5;
}
.title-bar-counter:before {
    content: "";
    height: 2px;
    width: 70px;
    background: var(--secondary-color);
    position: absolute;
    left: 0;
    margin: 0 auto;
    right: 0;
    bottom: 0;
    z-index: 3;
}
.title-bar-counter {
    position: relative;
}
.counter-area .counter-box p {
    color: var(--white-color);
    font-size: var(--font-5x);
    padding-top: 25px;
    padding-left: 15px;
    -webkit-box-flex: 2;
    -moz-flex: 2;
    -webkit-flex: 2;
    flex: 2;
    text-transform: uppercase;
    text-align: left;
    z-index: 1;
}

.facitiy-card{
	text-align:center;
	font-size:var(--font-4x);
    -webkit-transition-duration: 0.3s;
    transition-duration: 0.3s;
}
.facitiy-card:hover{
}
.facitiy-icon {
    padding: 20px;
    position: relative;
    border-radius: 50%;
    border:1px solid var(--primary-color);
    color: var(--primary-color);
    width: 100px;
    height: 100px;
    display: flex;
    align-items: center;
    margin: auto;
}
.facitiy-icon i {
    margin: 0 auto;
    font-size: 40px;
}
.facitiy-card:hover .facitiy-icon{
    -webkit-box-shadow: 0 0 15px rgb(0 0 0 / 10%);
    -moz-box-shadow: 0 0 15px rgb(0 0 0 / 10%);
	box-shadow: 0 0 15px rgb(0 0 0 / 10%);
	background:var(--primary-color);
    color: var(--white-color);
}
.facitiy-text{
	padding:15px;
	padding-top:15px;
}
.facitiy-card:hover .facitiy-text{
	color:var(--primary-color);
}
.center-card {
    margin-bottom: 20px;
    background: var(--white-color);
	margin: 0px 20px;
}
.center-image {
	width:100%;
	padding-bottom: 60%;
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
    -webkit-transition: all 0.3s ease-in-out;
}
.center-details {
    padding: 10px;
	position:relative;
}
.center-title{
	font-family: var(--secondary-font);
    font-size: var(--font-5x);
    color: var(--primary-color);
	margin:10px 0px;
}
.center-desc{
    font-size: var(--font-3x);
	display: block;
    display: -webkit-box;
    max-width: calc(100% - 5px);
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
}
.center-data-nav{
	display:flex;
	align-items:center;
	color:var(--primary-color);
}
.center-data-dots{
	width:100%;
	position:relative;
    text-align: center;
}
.center-data-prev, .center-data-next {
    font-size: 30px;
    text-align: center;
    border: none !important;;
    padding: 0 !important;
    background: transparent !important;
	color:var(--primary-color);
	cursor:pointer;
}
.center-data-dots button.owl-dot {
    font-family:FontAwesome;
    font-size: inherit;
    text-rendering: auto;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    margin: 0px 10px;
    border: none !important;;
    padding: 0 !important;
    background: transparent !important;
	color:var(--primary-color);
	cursor:pointer;
}
.center-data-dots .owl-dot:before {
    content: "\f10c";
}
.center-data-dots .owl-dot.active:before {
    content: "\f111";
}

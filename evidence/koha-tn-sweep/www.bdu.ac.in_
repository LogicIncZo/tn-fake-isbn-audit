    $('.para').animate({'line-height': '32px'});
    $('.list-group-item').animate({'font-size': '+=3'});
    $('.drop').animate({'font-size': '+=3'});
   

});

$('.original').on('click', function () {
    $('.para').animate({'font-size': '16px'});
    $('.para').animate({'line-height': '24px'});
    $('.list-group-item').animate({'font-size': '14px'});
    $('.drop').animate({'font-size': '15px'});
        
});


$('.down').on('click', function () {
    $('.para').animate({'font-size': '-=5'});

        <span class="pu-tooltip">View Recent Announcements</span>
    </div>

    <!-- Script Block for Pop-up Modal -->
    <script>
        // Get elements
        const puOverlay = document.getElementById('pu-modal-overlay');
        const puCheckbox = document.getElementById('pu-dont-show-checkbox');

        // Check if user set a preference to hide the modal today
        function checkPopupPreference() {
            const expiryTime = localStorage.getItem('pu_popup_hide_expiry');
            const currentTime = new Date().getTime();

            // If an expiry exists and is in the future, don't show the modal
            if (expiryTime && currentTime < parseInt(expiryTime)) {
                return false; 
            }
            
            // Clean up stale local storage
            if (expiryTime && currentTime >= parseInt(expiryTime)) {
                localStorage.removeItem('pu_popup_hide_expiry');
            }
            return true;
        }

        // Open the pop-up modal with animations and lock scrolling
        function openPeriyarPopup() {
            document.body.classList.add('pu-modal-open');
            puOverlay.classList.add('active');
        }

        // Close the pop-up modal and restore scrolling
        function closePeriyarPopup() {
            // Save state if "Don't show again" is checked
            if (puCheckbox.checked) {
                // Set expiry for 24 hours (1 day) from now
                const oneDayInMs = 24 * 60 * 60 * 1000;
                const expiryTimestamp = new Date().getTime() + oneDayInMs;
                localStorage.setItem('pu_popup_hide_expiry', expiryTimestamp.toString());
            }

            puOverlay.classList.remove('active');
            document.body.classList.remove('pu-modal-open');
        }

        // Trigger on load
        window.addEventListener('DOMContentLoaded', () => {
            if (checkPopupPreference()) {
                // Snappy delay of 300ms for rapid visual presentation
                setTimeout(openPeriyarPopup, 300);
            }
        });

        // Close when clicking outside the modal box (on the backdrop overlay)
        puOverlay.addEventListener('click', (e) => {
            if (e.target === puOverlay) {
                closePeriyarPopup();
            }
        });

        // Close when ESC key is pressed
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && puOverlay.classList.contains('active')) {
                closePeriyarPopup();
            }
        });
    </script>
